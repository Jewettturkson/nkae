# PostgreSQL connection string (Neon, Supabase, or local Postgres)
DATABASE_URL=postgresql://user:password@host:5432/preppal

# OpenAI API key — used server-side only for summaries, flashcards, and quizzes
OPENAI_API_KEY=sk-your-key

# Session secret for express-session
SESSION_SECRET=generate-a-long-random-string

# Firebase Auth
# Client (safe to expose, prefixed for Vite):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server (secret): base64 of the service-account JSON from Firebase console
FIREBASE_SERVICE_ACCOUNT_BASE64=
